# Get a key at https://console.anthropic.com. Without one, the app runs in demo mode.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional: shared secret the app sends in the x-app-key header. Set the same
# value as EXPO_PUBLIC_APP_KEY when building the app.
# APP_KEY=

# Daily limits (UTC day). Defaults shown.
# LIMIT_PER_DEVICE_PER_DAY=5
# LIMIT_PER_IP_PER_DAY=15
# LIMIT_GLOBAL_PER_DAY=200

# Shared limit storage. Add the free Upstash Redis integration in Vercel and
# these are set for you. Without it, limits only apply per server instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
